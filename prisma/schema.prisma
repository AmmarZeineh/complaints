// schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
  }

model UserRole {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  users User[]
  rolePermissions UserRolePermission[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt()
  deletedAt DateTime?
}

model Permission {
  id              Int                  @id @default(autoincrement())
  name            String               @unique
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt()
  deletedAt       DateTime?
  rolePermissions UserRolePermission[]
}

model UserRolePermission {
  id           Int        @id @default(autoincrement())
  userRoleId   Int
  permissionId Int
  userRole     UserRole   @relation(fields: [userRoleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt()
  deletedAt    DateTime?
  @@index([userRoleId, permissionId])
}

  model User {
    id          Int       @id @default(autoincrement())
    name        String
    nationalID  String?    @unique
    email       String    @unique
    password    String
    governmentId Int? 
    government        Government? @relation(fields: [governmentId], references: [id])
    tokens            UserToken[]  
    notifications     Notification[] 
    complaints        Complaint[] 
    notes             ComplaintNote[]
    history           ComplaintHistory[]
    roleId Int
    role   UserRole @relation(fields: [roleId], references: [id])
    sentInteractions      ComplaintInteraction[] @relation("InteractionSender")
    receivedInteractions  ComplaintInteraction[] @relation("InteractionReceiver")
    isEmailVerified   Boolean  @default(false)
    createdAt   DateTime  @default(now())
    updatedAt   DateTime  @updatedAt()
    deletedAt   DateTime?

  }

  model Government {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt()
  deletedAt   DateTime?
  users          User[] 
  complaints  Complaint[]
}

 model Complaint {
  id            Int      @id @default(autoincrement())
  userId        Int
  employeeId    Int?
  governmentId  Int
  type          String
  Location      String
  description   String
  images       String?   @db.Text  
  documents    String?   @db.Text  
  status        Status   @default(NEW)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt()
  deletedAt   DateTime?
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  government  Government  @relation(fields: [governmentId], references: [id], onDelete: Cascade)
  notes         ComplaintNote[]
  interactions ComplaintInteraction[]
   history      ComplaintHistory[]
}

enum Status {
  NEW
  INPROCESS
  COMPLETED
  REJECTED
} 


model ComplaintInteraction {
  id           Int              @id @default(autoincrement())
  complaintId  Int
  senderId     Int
  receiverId   Int?             
  message      String           @db.Text
  type         InteractionType
  images       String?          @db.Text  
  documents    String?          @db.Text 
  isRead       Boolean          @default(false)
  createdAt    DateTime         @default(now())
  updatedAt   DateTime  @updatedAt()
  deletedAt   DateTime?
  complaint    Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  sender       User @relation("InteractionSender", fields: [senderId], references: [id])
  receiver     User? @relation("InteractionReceiver", fields: [receiverId], references: [id])
  
  @@index([complaintId])
  @@index([senderId])
}
enum InteractionType {
  REQUEST_INFO     
  CITIZEN_RESPONSE  
}


model ComplaintNote {
  id           Int       @id @default(autoincrement())
  complaintId  Int
  userId       Int       
  content      String    @db.Text
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt()
  deletedAt    DateTime?
  
  complaint    Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  user         User      @relation(fields: [userId], references: [id])
  
  @@index([complaintId])
  @@index([userId])
}

model ComplaintHistory {
  id           Int      @id @default(autoincrement())
  complaintId  Int
  userId       Int 
  action       HistoryAction
  oldValue     String?  @db.Text 
  newValue     String?  @db.Text 
  description  String   @db.Text 
  metadata     Json?
  createdAt    DateTime @default(now())
  deletedAt    DateTime?
  
  complaint    Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  user         User      @relation(fields: [userId], references: [id])
  
  @@index([complaintId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

enum HistoryAction {
  COMPLAINT_CREATED 
  COMPLAINT_UPDATED      
  COMPLAINT_ASSIGNED 
  STATUS_CHANGED 
  NOTE_ADDED  
  INTERACTION_CREATED   
  COMPLAINT_DELETED  
}

  model EmailVerification {
  id        Int      @id @default(autoincrement())
  email     String
  code      String
  expiresAt DateTime
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt()
  deletedAt   DateTime?
}

model UserToken {
  id         Int      @id @default(autoincrement())
  userId     Int
  fcmToken   String   @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  deletedAt   DateTime?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  type      String?   
  data      Json?   
  isRead    Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt        DateTime @updatedAt()
  deletedAt        DateTime?

}

