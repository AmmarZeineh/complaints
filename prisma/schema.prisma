// schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
  }

model UserRole {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  users User[]
  rolePermissions UserRolePermission[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt()
  deletedAt DateTime?
}

model Permission {
  id              Int                  @id @default(autoincrement())
  name            String               @unique
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt()
  deletedAt       DateTime?
  rolePermissions UserRolePermission[]
}

model UserRolePermission {
  id           Int        @id @default(autoincrement())
  userRoleId   Int
  permissionId Int
  userRole     UserRole   @relation(fields: [userRoleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt()
  deletedAt    DateTime?
  @@index([userRoleId, permissionId])
}

  model User {
    id          Int       @id @default(autoincrement())
    name        String
    nationalID  String?    @unique
    email       String    @unique
    password    String
    governmentId Int? 
    government   Government? @relation(fields: [governmentId], references: [id])
    tokens            UserToken[]  
    notifications     Notification[] 
    complaints          Complaint[] 
    notes         ComplaintNote[]
    roleId Int
    role   UserRole @relation(fields: [roleId], references: [id])
    isEmailVerified   Boolean  @default(false)
    createdAt   DateTime  @default(now())
    updatedAt   DateTime  @updatedAt()
    deletedAt   DateTime?

  }

  model Government {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt()
  deletedAt   DateTime?
  users          User[] 
  complaints  Complaint[]
}

 model Complaint {
  id            Int      @id @default(autoincrement())
  userId        Int
  employeeId    Int?
  governmentId  Int
  type          String
  Location      String
  description   String
  images       String?   @db.Text  
  documents    String?   @db.Text  
  status        Status   @default(NEW)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt()
  deletedAt   DateTime?
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  government  Government  @relation(fields: [governmentId], references: [id], onDelete: Cascade)
  notes         ComplaintNote[]

}

